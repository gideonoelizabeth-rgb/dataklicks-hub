{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/designlikeaprowithai", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/DESIGNLIKEAPROWITHAI", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/Designlikeaprowithai", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/DesignLikeAProWithAI", "destination": "/DesignlikeaPROwithAI", "permanent": false },
