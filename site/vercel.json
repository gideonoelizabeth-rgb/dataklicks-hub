    { "source": "/design-like-a-pro-with-AI", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/register", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/Register", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/REGISTER", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/training", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/Training", "destination": "/DesignlikeaPROwithAI", "permanent": false },
    { "source": "/ai-class", "destination": "/DesignlikeaPROwithAI", "permanent": false },
